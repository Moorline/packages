{
  "id": "rync/missions",
  "name": "rync/missions",
  "version": "0.0.1",
  "type": "plugin",
  "description": "Package-owned scheduled missions implemented as durable sessions.",
  "entrypoint": "index.mjs",
  "capabilities": [
    "transport.message.send",
    "transport.resource.create",
    "transport.resource.update",
    "session.inspect",
    "session.create",
    "session.direct",
    "package.state.read",
    "package.state.write",
    "package.job.manage"
  ],
  "hooks": [
    "onAction",
    "beforeAgentPrompt"
  ],
  "defaultEnabled": true
}
