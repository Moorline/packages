{
  "id": "official/session-commands",
  "name": "official/session-commands",
  "version": "0.0.1",
  "type": "plugin",
  "description": "Provides Discord actions for creating, listing, archiving, and deleting sessions.",
  "entrypoint": "index.mjs",
  "capabilities": [
    "transport.message.send",
    "transport.resource.create",
    "transport.resource.update",
    "transport.resource.delete",
    "session.create",
    "session.archive",
    "session.delete"
  ],
  "hooks": [
    "onAction"
  ],
  "defaultEnabled": true,
  "dependencies": [
    {
      "surface": "transport",
      "packageId": "official/discord",
      "requiredState": "active",
      "reason": "Session controls are delivered through the official Discord transport."
    }
  ]
}
