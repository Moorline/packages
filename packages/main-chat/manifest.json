{
  "id": "official/main-chat",
  "name": "official/main-chat",
  "version": "0.0.1",
  "type": "plugin",
  "description": "Routes #moorline-chat to the main coordination assistant.",
  "entrypoint": "index.mjs",
  "priority": 100,
  "capabilities": [
    "transport.message.send",
    "net.connect",
    "fs.read"
  ],
  "hooks": [
    "onTransportEvent"
  ],
  "defaultEnabled": true,
  "dependencies": [
    {
      "surface": "transport",
      "packageId": "official/discord",
      "requiredState": "active",
      "reason": "Main chat routing depends on the official Discord transport."
    }
  ]
}
