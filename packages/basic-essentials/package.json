{
  "name": "@rync/moorline-basic-essentials",
  "version": "0.0.4",
  "description": "Shared Moorline essentials for memory and persona.",
  "type": "module",
  "private": false,
  "files": [
    "manifest.json",
    "moorline.dist.json",
    "*.mjs",
    "*.mjs.d.ts",
    "*.md"
  ],
  "scripts": {
    "build": "true",
    "typecheck": "true"
  },
  "moorline": {
    "schemaVersion": 1,
    "packageId": "rync/basic-essentials",
    "kind": "bundle",
    "manifestPath": "manifest.json",
    "distroPath": "moorline.dist.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Moorline/packages.git",
    "directory": "packages/basic-essentials"
  },
  "keywords": [
    "moorline-package"
  ]
}
