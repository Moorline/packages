{
  "id": "rync/channel-lifecycle",
  "name": "rync/channel-lifecycle",
  "version": "0.0.2",
  "type": "plugin",
  "description": "Provides archive and delete controls for Moorline-managed Discord resources.",
  "entrypoint": "index.mjs",
  "capabilities": [
    "transport.message.send",
    "transport.resource.update",
    "transport.resource.delete",
    "session.archive",
    "session.delete"
  ],
  "hooks": [
    "onAction"
  ],
  "defaultEnabled": true,
  "dependencies": [
    {
      "surface": "transport",
      "packageId": "rync/discord",
      "requiredState": "active",
      "reason": "Resource lifecycle controls target Discord-managed resources."
    }
  ]
}
