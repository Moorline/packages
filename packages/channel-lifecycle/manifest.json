{
  "id": "official/channel-lifecycle",
  "name": "official/channel-lifecycle",
  "version": "0.0.1",
  "type": "plugin",
  "description": "Provides archive and delete controls for Moorline-managed Discord spaces.",
  "entrypoint": "index.mjs",
  "capabilities": [
    "transport.message.send",
    "transport.space.update",
    "transport.space.delete",
    "session.archive",
    "session.delete"
  ],
  "hooks": [
    "onAction"
  ],
  "defaultEnabled": true,
  "dependencies": [
    {
      "surface": "transport",
      "packageId": "official/discord",
      "requiredState": "active",
      "reason": "Space lifecycle controls target Discord-managed spaces."
    }
  ]
}
