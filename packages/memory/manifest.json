{
  "id": "rync/memory",
  "name": "rync/memory",
  "version": "0.0.2",
  "type": "plugin",
  "description": "Layered memory retrieval and memory writing for Moorline sessions.",
  "entrypoint": "index.mjs",
  "capabilities": [
    "memory.read",
    "memory.write",
    "fs.write"
  ],
  "hooks": [
    "contributeAgentContext",
    "afterAgentResponse"
  ],
  "defaultEnabled": true
}
