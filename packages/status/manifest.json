{
  "id": "rync/status",
  "name": "rync/status",
  "version": "0.0.2",
  "type": "plugin",
  "description": "Provides runtime status and control actions.",
  "entrypoint": "index.mjs",
  "capabilities": [
    "memory.read",
    "transport.message.send",
    "net.connect"
  ],
  "hooks": [
    "onAction",
    "onDomainEvent"
  ],
  "defaultEnabled": true,
  "dependencies": [
    {
      "surface": "transport",
      "packageId": "rync/discord",
      "requiredState": "active",
      "reason": "Status actions are delivered through the rync Discord transport."
    }
  ]
}
