{
  "id": "official/session-agent",
  "name": "official/session-agent",
  "version": "0.0.1",
  "type": "plugin",
  "description": "Routes session-resource messages into worker sessions.",
  "entrypoint": "index.mjs",
  "priority": 100,
  "capabilities": [
    "transport.message.send",
    "net.connect",
    "fs.read"
  ],
  "hooks": [
    "onTransportEvent"
  ],
  "defaultEnabled": true,
  "dependencies": [
    {
      "surface": "transport",
      "packageId": "official/discord",
      "requiredState": "active",
      "reason": "Session routing depends on the official Discord transport."
    }
  ]
}
