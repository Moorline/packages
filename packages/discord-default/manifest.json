{
  "id": "rync/discord-default",
  "name": "rync/discord-default",
  "version": "0.0.6",
  "type": "bundle",
  "description": "Rync Discord transport and Discord runtime features.",
  "members": [
    {
      "kind": "transport",
      "packageId": "rync/discord",
      "version": "~0.0.5",
      "activation": "select"
    },
    {
      "kind": "plugin",
      "packageId": "rync/discord-runtime",
      "version": "~0.0.6",
      "activation": "enable"
    }
  ]
}
