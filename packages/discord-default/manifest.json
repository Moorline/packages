{
  "id": "rync/discord-default",
  "name": "rync/discord-default",
  "version": "0.0.1",
  "type": "bundle",
  "description": "Rync Discord transport and Discord runtime features.",
  "members": [
    {
      "kind": "transport",
      "packageId": "rync/discord",
      "version": "~0.0.1",
      "activation": "select"
    },
    {
      "kind": "plugin",
      "packageId": "rync/admin-control",
      "version": "~0.0.1",
      "activation": "enable"
    },
    {
      "kind": "plugin",
      "packageId": "rync/channel-lifecycle",
      "version": "~0.0.1",
      "activation": "enable"
    },
    {
      "kind": "plugin",
      "packageId": "rync/coordination",
      "version": "~0.0.1",
      "activation": "enable"
    },
    {
      "kind": "plugin",
      "packageId": "rync/missions",
      "version": "~0.0.1",
      "activation": "enable"
    },
    {
      "kind": "plugin",
      "packageId": "rync/session-agent",
      "version": "~0.0.1",
      "activation": "enable"
    },
    {
      "kind": "plugin",
      "packageId": "rync/session-commands",
      "version": "~0.0.1",
      "activation": "enable"
    },
    {
      "kind": "plugin",
      "packageId": "rync/status",
      "version": "~0.0.1",
      "activation": "enable"
    }
  ]
}
